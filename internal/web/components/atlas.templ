package components

import (
	"fmt"
	"strings"
	"github.com/biorisk/flying-shuttle/internal/web/viewmodel"
)

// AtlasList is the #atlas fragment: the browsable region list for the Source
// Atlas — the derived NETWORK over the transcript corpus (regions +
// similarity links). It is not the outline. Shown when $atlasOpen; it
// replaces #evidence in the right column while open, independent of which
// main view ($centerView) is active — so browsing back to the outline still
// leaves it in place. The network graph itself lives in AtlasCanvas, in the
// main column.
templ AtlasList(vm viewmodel.AtlasPane) {
	<section id="atlas" class="atlas-pane" aria-label="Source atlas" data-show="$atlasOpen">
		<header class="atlas-head">
			<strong>Source atlas</strong>
			<button type="button" class="atlas-close" data-on:click="$atlasOpen = false; $atlasRegionId = ''; $atlasChunkId = ''; $centerView = ($centerView === 'atlas' ? 'outline' : $centerView)">×</button>
		</header>
		<div class="atlas-scroll">
			<div id="atlas-selected-chunk" class="atlas-selected"></div>
			switch vm.Status {
				case "ready":
					@atlasRegionList(vm)
				case "building":
					<p class="atlas-empty" data-on-interval__duration.2s="@get('/atlas')">
						Building the atlas… clustering { fmt.Sprint(vm.ChunkCount) } passages and summarising each group.
					</p>
				case "failed":
					<p class="atlas-empty atlas-error">Atlas build failed: { vm.Error }</p>
					<button type="button" class="atlas-build" data-on:click="@post('/atlas/rebuild')">Try again</button>
				default:
					<p class="atlas-empty">
						The atlas groups your transcript passages into a browsable map of topics.
						Upload transcripts, let embeddings finish, then build it.
					</p>
					<button type="button" class="atlas-build" data-on:click="@post('/atlas/rebuild')">Build the atlas</button>
			}
		</div>
	</section>
}

// AtlasCanvas is the #atlas-canvas fragment: the Source Atlas network graph
// (Cytoscape, via atlas_graph.js). It takes over the main column, replacing
// #outline/#stitch, while $centerView === 'atlas'. The top-level graph nodes
// are transcripts (source files), coloured by their dominant region; tapping
// one fires 'atlasnode' for its primary region tag (loading that region's
// detail into AtlasList in the right pane) and drills into that transcript's
// own chunks in document order, each coloured by its region. Tapping a chunk
// fires 'atlaschunk', which loads the passage into #atlas-selected-chunk in
// the right pane — same place any other evidence would appear.
templ AtlasCanvas(vm viewmodel.AtlasPane) {
	<section id="atlas-canvas" data-show="$centerView === 'atlas'">
		if vm.Status == "ready" {
			<div id="atlas-graph" class="atlas-graph"
				data-on:atlasnode="$atlasRegionId = evt.detail.id; @get('/atlas/regions/' + evt.detail.id)"
				data-on:atlaschunk="$atlasChunkId = evt.detail.id; @get('/atlas/chunk/' + evt.detail.id)"></div>
			// When a rebuild finishes ($atlasBuiltAt changes, $atlasBuilding
			// false), reload the graph in place so it swaps to the new build.
			<div hidden data-on-signal-patch="!$atlasBuilding && window.atlasGraph && window.atlasGraph.syncTo && window.atlasGraph.syncTo($atlasBuiltAt)"></div>
		}
	</section>
}

templ atlasRegionList(vm viewmodel.AtlasPane) {
	<div class="atlas-toolbar">
		<span class="atlas-count">{ fmt.Sprintf("%d regions · %d passages", len(vm.Regions), vm.ChunkCount) }</span>
		if !vm.Rebuilding {
			<button type="button" class="atlas-rebuild" data-on:click="@post('/atlas/rebuild')" title="Rebuild from the current corpus">rebuild</button>
		}
	</div>
	if vm.Rebuilding {
		<p class="atlas-rebuilding" data-on-interval__duration.3s="@get('/atlas')">
			Rebuilding… this map stays usable until the new one is ready.
		</p>
	} else if vm.Stale {
		<p class="atlas-stale">Atlas is { fmt.Sprint(vm.Behind) } passages behind — rebuild to refresh.</p>
	}
	<input
		class="atlas-search"
		type="search"
		placeholder="search the atlas…"
		data-bind="atlasQuery"
		data-on:input__debounce.300ms="@get('/atlas/search?q=' + encodeURIComponent($atlasQuery))"
	/>
	@AtlasMatches(vm.Matches)
	<ul class="atlas-regions">
		for _, r := range vm.Regions {
			<li class={ "atlas-region", templ.KV("open", r.ID == vm.RegionOpen) }>
				<button
					type="button"
					class="atlas-region-head"
					data-on:click={ fmt.Sprintf("$atlasRegionId = ($atlasRegionId === %q ? '' : %q); @get('/atlas/regions/%s')", r.ID, r.ID, r.ID) }
				>
					<span class="atlas-region-title">
						<span class="atlas-swatch" style={ swatch(r.Color) }></span>
						{ nonEmpty(r.Title, "untitled region") }
					</span>
					<span class="atlas-region-n">{ fmt.Sprint(r.ChunkCount) }</span>
				</button>
				<p class="atlas-region-kw">{ strings.Join(r.Keywords, " · ") }</p>
				<div id={ "atlas-region-" + r.ID } class="atlas-region-detail" data-show={ fmt.Sprintf("$atlasRegionId === %q", r.ID) }></div>
			</li>
		}
	</ul>
}

// AtlasRegion is the #atlas-region-<id> fragment: one region's digest, its
// member passages (reusing the evidence Candidate card), and linked regions.
templ AtlasRegion(vm viewmodel.AtlasRegionDetail) {
	<div id={ "atlas-region-" + vm.ID } class="atlas-region-detail" data-show={ fmt.Sprintf("$atlasRegionId === %q", vm.ID) }>
		if vm.Abstract != "" {
			<p class="atlas-abstract">{ vm.Abstract }</p>
		}
		<p class="atlas-source" title="how this summary was produced">{ vm.Source }</p>
		if len(vm.Members) > 0 {
			<ul class="atlas-members candidate-list">
				for _, c := range vm.Members {
					<li class="candidate" data-chunk={ c.ChunkID } data-source={ c.SourceFile }>
						<div class="candidate-meta">
							<span class="candidate-source">{ c.SourceFile }</span>
							<button
								type="button"
								class="candidate-open"
								data-on:click={ "@get('/evidence/transcript?node=' + ($focusId||'') + '&chunk=" + c.ChunkID + "')" }
							>Read in transcript →</button>
							<button
								type="button"
								class="atlas-attach"
								data-attr:disabled="!$focusId"
								data-on:click={ "@post('/outline/nodes/' + ($focusId||'') + '/evidence?chunk_id=" + c.ChunkID + "')" }
							>Add as evidence</button>
						</div>
						<p class="candidate-text">{ c.Snippet }</p>
					</li>
				}
			</ul>
		}
		if len(vm.Neighbours) > 0 {
			<div class="atlas-neighbours">
				<span class="atlas-neighbours-label">related regions</span>
				for _, n := range vm.Neighbours {
					<button
						type="button"
						class="atlas-hop"
						data-on:click={ fmt.Sprintf("$atlasRegionId = %q; @get('/atlas/regions/%s')", n.ID, n.ID) }
					>
						<span class="atlas-swatch" style={ swatch(n.Color) }></span>
						{ nonEmpty(n.Title, "untitled") }
					</button>
				}
			</div>
		}
	</div>
}

// AtlasMatches is the #atlas-matches fragment: regions ranked for a query or
// the focused bullet, as hop buttons.
templ AtlasMatches(vm viewmodel.AtlasMatches) {
	<div id="atlas-matches" class="atlas-matches">
		if len(vm.Regions) > 0 {
			<span class="atlas-matches-label">{ nonEmpty(vm.Label, "matches") }</span>
			for _, r := range vm.Regions {
				<button
					type="button"
					class="atlas-hop"
					data-on:click={ fmt.Sprintf("$atlasRegionId = %q; @get('/atlas/regions/%s')", r.ID, r.ID) }
				>
					<span class="atlas-swatch" style={ swatch(r.Color) }></span>
					{ nonEmpty(r.Title, "untitled") }
					if len(r.Keywords) > 0 {
						<span class="atlas-hop-kw">{ strings.Join(r.Keywords, " · ") }</span>
					}
				</button>
			}
		}
	</div>
}

// AtlasSelectedChunk is the #atlas-selected-chunk fragment: the passage tapped
// in the network graph, shown in the Atlas right pane as an evidence-style
// card with the shared Read / Attach actions — the same place any other
// evidence appears.
templ AtlasSelectedChunk(c viewmodel.Candidate) {
	<div id="atlas-selected-chunk" class="atlas-selected" data-show={ fmt.Sprintf("$atlasChunkId === %q", c.ChunkID) }>
		<div class="atlas-selected-head">
			<span class="atlas-selected-label">selected passage</span>
			<button type="button" class="atlas-close" data-on:click="$atlasChunkId = ''">×</button>
		</div>
		<div class="candidate" data-chunk={ c.ChunkID } data-source={ c.SourceFile }>
			<div class="candidate-meta">
				<span class="candidate-source">{ c.SourceFile }</span>
				<button
					type="button"
					class="candidate-open"
					data-on:click={ "@get('/evidence/transcript?node=' + ($focusId||'') + '&chunk=" + c.ChunkID + "'); $atlasOpen = false; $atlasChunkId = ''" }
				>Read in transcript →</button>
				<button
					type="button"
					class="atlas-attach"
					data-attr:disabled="!$focusId"
					data-on:click={ "@post('/outline/nodes/' + ($focusId||'') + '/evidence?chunk_id=" + c.ChunkID + "')" }
				>Add as evidence</button>
			</div>
			<p class="candidate-text">{ c.Snippet }</p>
		</div>
	</div>
}

func nonEmpty(s, fallback string) string {
	if strings.TrimSpace(s) == "" {
		return fallback
	}
	return s
}

// swatch is the inline style for a region colour chip. The colour is always
// one of a fixed hex palette (see regionColor), so it's safe CSS.
func swatch(color string) templ.SafeCSS {
	if color == "" {
		color = "transparent"
	}
	return templ.SafeCSS("background:" + color)
}
