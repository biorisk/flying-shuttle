package components

import "github.com/biorisk/flying-shuttle/internal/web/viewmodel"

// Outline is the center-pane fragment: the nested, editable bullet tree.
// Rendered into #outline on first load and re-patched by the structural
// endpoints. A data-effect keeps the DOM focus on $focusId's input after a
// patch swaps the tree.
templ Outline(vm viewmodel.Outline) {
	<section
		id="outline"
		class="outline-pane"
		data-thread={ vm.ThreadID }
		data-class="{ threading: $threadId }"
		data-show="$centerView === 'outline'"
		data-effect="const id=$focusId; if(id){ const i=document.querySelector('#bullet-'+CSS.escape(id)+' .bullet-input'); if(i && document.activeElement!==i){ i.focus(); try{ i.setSelectionRange(i.value.length, i.value.length) }catch(e){} } }"
	>
		<form
			id="move-form"
			hidden
			data-on:submit__prevent="@post('/outline/move', {contentType:'form'})"
		>
			<input type="hidden" name="node_id"/>
			<input type="hidden" name="parent_id"/>
			<input type="hidden" name="position"/>
		</form>
		if vm.Empty() {
			<div class="outline-empty">
				<p>No outline yet.</p>
				<button type="button" class="add-first" data-on:click="@post('/outline/roots')">Add the first bullet</button>
			</div>
		} else {
			<ul class="bullet-tree">
				for _, n := range vm.Roots {
					@bullet(n)
				}
			</ul>
		}
	</section>
}

templ bullet(n viewmodel.OutlineNode) {
	if n.Ghost {
		<li class="bullet ghost" style={ "padding-left:" + intString(n.Depth*20) + "px" }>
			<div class="bullet-row">
				<span class="bullet-dot" aria-hidden="true">&bull;</span>
				<span class="ghost-title">{ orEmpty(n.Title) }</span>
				<button
					type="button"
					class="ghost-rescue"
					data-on:click={ "@post('/outline/rescue?diff=' + ($diffAgainst||'') + '&node=" + n.ID + "')" }
				>Rescue</button>
			</div>
		</li>
	} else {
		<li
			id={ "bullet-" + n.ID }
			class={ "bullet", templ.KV("locked", n.Locked), templ.KV("evidence", n.Evidence), templ.KV("in-thread", n.InThread), templ.KV("diff-added", n.Diff == "added"), templ.KV("diff-changed", n.Diff == "changed") }
			data-node-id={ n.ID }
			data-prev-id={ n.Prev }
			data-next-id={ n.Next }
			data-depth={ intString(n.Depth) }
		>
			<div class="bullet-row" style={ "padding-left:" + intString(n.Depth*20) + "px" }>
			if !n.Evidence {
				<span class="drag-handle" draggable="true" title="Drag to move" aria-hidden="true">&#8942;</span>
			}
			if len(n.Children) > 0 {
				<button
					type="button"
					class="bullet-toggle"
					tabindex="-1"
					data-on:click={ "$collapsed['" + n.ID + "'] = !$collapsed['" + n.ID + "']" }
					data-text={ "$collapsed['" + n.ID + "'] ? '▸' : '▾'" }
				>&#9662;</button>
			} else {
				<span class="bullet-dot" aria-hidden="true">
					if n.Evidence {
						&#9642;
					} else {
						&bull;
					}
				</span>
			}
			if n.Evidence {
				<blockquote class="bullet-evidence">{ evidenceText(n) }</blockquote>
				if n.Locked {
					<span class="bullet-lock" title="Locked">&#128274;</span>
				}
			} else {
				<form class="bullet-form" data-on:submit__prevent={ "@post('/outline/nodes/" + n.ID + "/sibling', {contentType:'form'})" }>
					<input type="hidden" name="version" value={ intString(n.Version) }/>
					<input
						class="bullet-input"
						name="title"
						value={ n.Title }
						autocomplete="off"
						placeholder="Untitled"
						data-on:focus={ "$focusId = '" + n.ID + "'; " + evidenceExpr(n.ID) }
						data-on:input__debounce.300ms={ evidenceExpr(n.ID) }
						data-on:blur={ "@patch('/outline/nodes/" + n.ID + "', {contentType:'form'})" }
						data-on:keydown={ keydownExpr(n.ID) }
					/>
				</form>
				<button
					type="button"
					class={ "thread-toggle", templ.KV("on", n.InThread) }
					tabindex="-1"
					data-show="!!$threadId"
					data-on:click={ threadToggleExpr(n.ID) }
					title="In/out of thread — Brush mode appends to the path"
				>
					if n.InThread {
						&#9673;
					} else {
						&#9711;
					}
				</button>
				<button
					type="button"
					class="exit-toggle"
					tabindex="-1"
					data-on:click={ "$exits['" + n.ID + "'] = !$exits['" + n.ID + "']; $exits['" + n.ID + "'] && @get('/outline/nodes/" + n.ID + "/exits')" }
					title="Continuations / CYOA exits"
				>&#8631;</button>
			}
		</div>
		if !n.Evidence {
			<div id={ "exits-" + n.ID } class="bullet-exits" data-show={ "!!$exits['" + n.ID + "']" }></div>
		}
			if len(n.Children) > 0 {
				<ul class="bullet-children" data-show={ "!$collapsed['" + n.ID + "']" }>
					for _, c := range n.Children {
						@bullet(c)
					}
				</ul>
			}
		</li>
	}
}
