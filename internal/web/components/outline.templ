package components

import "github.com/biorisk/flying-shuttle/internal/web/viewmodel"

// Outline is the center-pane fragment: the nested, editable bullet tree.
// Rendered into #outline on first load and re-patched by the structural
// endpoints. A data-effect keeps the DOM focus on $focusId's input after a
// patch swaps the tree.
templ Outline(vm viewmodel.Outline) {
	<section
		id="outline"
		class="outline-pane"
		data-show="$centerView === 'outline'"
		data-effect="const id=$focusId; if(id){ const i=document.querySelector('#bullet-'+CSS.escape(id)+' .bullet-input'); if(i && document.activeElement!==i){ i.focus(); try{ i.setSelectionRange(i.value.length, i.value.length) }catch(e){} } }"
	>
		if vm.Empty() {
			<div class="outline-empty">
				<p>No outline yet.</p>
				<button type="button" class="add-first" data-on-click="@post('/app/outline/roots')">Add the first bullet</button>
			</div>
		} else {
			<ul class="bullet-tree">
				for _, n := range vm.Roots {
					@bullet(n)
				}
			</ul>
		}
	</section>
}

templ bullet(n viewmodel.OutlineNode) {
	<li
		id={ "bullet-" + n.ID }
		class={ "bullet", templ.KV("locked", n.Locked), templ.KV("evidence", n.Evidence) }
		data-node-id={ n.ID }
		data-prev-id={ n.Prev }
		data-next-id={ n.Next }
		data-depth={ intString(n.Depth) }
	>
		<div class="bullet-row" style={ "padding-left:" + intString(n.Depth*20) + "px" }>
			<span class="bullet-dot" aria-hidden="true">
				if n.Evidence {
					&#9642;
				} else {
					&bull;
				}
			</span>
			if n.Evidence {
				<blockquote class="bullet-evidence">{ evidenceText(n) }</blockquote>
				if n.Locked {
					<span class="bullet-lock" title="Locked">&#128274;</span>
				}
			} else {
				<form class="bullet-form" data-on-submit__prevent={ "@post('/app/outline/nodes/" + n.ID + "/sibling', {contentType:'form'})" }>
					<input type="hidden" name="version" value={ intString(n.Version) }/>
					<input
						class="bullet-input"
						name="title"
						value={ n.Title }
						autocomplete="off"
						placeholder="Untitled"
						data-on-focus={ "$focusId = '" + n.ID + "'" }
						data-on-blur={ "@patch('/app/outline/nodes/" + n.ID + "', {contentType:'form'})" }
						data-on-keydown={ keydownExpr(n.ID) }
					/>
				</form>
			}
		</div>
		if len(n.Children) > 0 {
			<ul class="bullet-children">
				for _, c := range n.Children {
					@bullet(c)
				}
			</ul>
		}
	</li>
}
