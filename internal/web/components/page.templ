package components

// Page is the full application shell: a collapsible left ingest drawer, the
// Outline as the main column, and the Evidence pane on the right.
//
// The outline and evidence arguments are the *fragment* components — each owns
// its own root element (`#outline`, `#evidence`), so the same component is used
// for the initial server render here and for later Datastar SSE patches. When
// nil, a matching empty placeholder element is rendered to keep the grid and
// the patch targets intact.
//
// Signals (page-scoped, reset on reload — matching the old client):
//   focusId       — id of the bullet currently being edited (attach target)
//   drawerOpen    — left ingest drawer visible
//   centerView    — "outline" | "preview"
//   threadId      — selected audience thread ("" = all)
//   evidenceWidth — right pane width in px
//   collapsed     — { [nodeId]: true } map of collapsed outline subtrees
templ Page(outline, evidence, ingest templ.Component) {
	@Base("Flying Shuttle") {
		<div
			id="shell"
			class="shell"
			data-signals="{ focusId: '', drawerOpen: false, centerView: 'outline', threadId: '', evidenceWidth: 420, collapsed: {} }"
			data-class="{ 'drawer-open': $drawerOpen }"
			data-style-grid-template-columns="($drawerOpen ? '300px ' : '0 ') + '1fr ' + $evidenceWidth + 'px'"
		>
			<aside id="ingest-drawer" class="drawer" aria-label="Transcript ingest">
				<header class="drawer-head">
					<span>Transcripts</span>
					<button type="button" class="icon-btn" data-on-click="$drawerOpen = false" title="Close">&times;</button>
				</header>
				if ingest != nil {
					@ingest
				} else {
					<div id="ingest" class="drawer-body"></div>
				}
			</aside>
			<main class="center">
				<nav class="topbar">
					<button
						type="button"
						class="icon-btn drawer-toggle"
						data-show="!$drawerOpen"
						data-on-click="$drawerOpen = true"
						title="Load transcripts"
					>&#9776;</button>
					<span class="view-tabs">
						<button type="button" data-class="{ active: $centerView === 'outline' }" data-on-click="$centerView = 'outline'">Outline</button>
						<button type="button" data-class="{ active: $centerView === 'preview' }" data-on-click="$centerView = 'preview'">Preview</button>
					</span>
					<span id="thread-bar" class="thread-bar"><!-- task .5.1 --></span>
				</nav>
				if outline != nil {
					@outline
				} else {
					<section id="outline" class="outline-pane" data-show="$centerView === 'outline'"></section>
				}
				<section id="preview" class="preview-pane" data-show="$centerView === 'preview'">
					<!-- task .5.6 -->
				</section>
			</main>
			if evidence != nil {
				@evidence
			} else {
				<section id="evidence" class="evidence-pane" aria-label="Evidence">
					<p class="evidence-empty">Start typing a bullet — supporting passages appear here.</p>
				</section>
			}
		</div>
	}
}
