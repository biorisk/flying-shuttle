package components

import (
	"fmt"
	"github.com/biorisk/flying-shuttle/internal/web/viewmodel"
)

// Evidence is the right-pane fragment. It holds two stacked regions:
//   #evidence-candidates — ranked passages for the current bullet
//   #transcript-reader   — the scrubbable source transcript for one candidate
//
// $readerChunk (page signal) toggles between them.
templ Evidence(vm viewmodel.EvidencePane) {
	<div id="evidence" class="evidence-pane" aria-label="Evidence">
		<div id="evidence-candidates" data-show="!$readerChunk">
			if vm.Query == "" {
				<p class="evidence-empty">Start typing a bullet — supporting passages appear here.</p>
			} else if len(vm.Candidates) == 0 {
				<p class="evidence-empty">No passages found for “{ vm.Query }”.</p>
			} else {
				<header class="evidence-head">
					<span class="evidence-count">{ fmt.Sprintf("%d passages", len(vm.Candidates)) }</span>
					<span class="evidence-q" title="query">{ vm.Query }</span>
				</header>
				<ul class="candidate-list">
					for _, c := range vm.Candidates {
						<li class="candidate" data-chunk={ c.ChunkID } data-source={ c.SourceFile }>
							<div class="candidate-meta">
								<span class="candidate-source">{ c.SourceFile }</span>
								if c.Speaker != "" {
									<span class="candidate-speaker">{ c.Speaker }</span>
								}
								<button
									type="button"
									class="candidate-open"
									data-on:click={ "@get('/evidence/transcript?node=' + ($focusId||'') + '&chunk=" + c.ChunkID + "')" }
								>Read in transcript →</button>
							</div>
							<p class="candidate-text">
								if len(c.Segments) > 0 {
									for _, s := range c.Segments {
										if s.Mark {
											<mark>{ s.Text }</mark>
										} else {
											{ s.Text }
										}
									}
								} else {
									{ c.Snippet }
								}
							</p>
						</li>
					}
				</ul>
			}
		</div>
		@TranscriptReader(viewmodel.TranscriptReader{})
	</div>
}

// TranscriptReader renders the #transcript-reader region: a continuous slice of
// one source transcript with prev/next scrubbing across chunk boundaries. The
// selection-to-excerpt (.3.6) and attach button (.3.7) layer on next.
templ TranscriptReader(vm viewmodel.TranscriptReader) {
	<div id="transcript-reader" class="transcript-reader" data-show="!!$readerChunk">
		if !vm.Empty() {
			<header class="reader-head">
				<button type="button" class="reader-back" data-on:click="$readerChunk = ''">← passages</button>
				<span class="reader-source">{ vm.SourceFile }</span>
			</header>
			<div class="reader-scrub">
				if vm.HasPrev {
					<button type="button" data-on:click={ "@get('/evidence/transcript?node=' + ($focusId||'') + '&chunk=" + vm.PrevChunk + "')" }>‹ earlier</button>
				}
				if vm.HasNext {
					<button type="button" data-on:click={ "@get('/evidence/transcript?node=' + ($focusId||'') + '&chunk=" + vm.NextChunk + "')" }>later ›</button>
				}
			</div>
			<div class="reader-body" data-reader-source={ vm.SourceFile }>
				for _, seg := range vm.Segments {
					<span
						class={ "reader-seg", templ.KV("focus", seg.Focus) }
						data-chunk={ seg.ChunkID }
						data-char-start={ intString(seg.CharStart) }
					>{ seg.Text + " " }</span>
				}
			</div>
			<form
				id="excerpt-form"
				class="excerpt-form"
				data-on:submit__prevent="@post('/outline/nodes/' + ($focusId||'') + '/evidence', {contentType:'form'})"
			>
				<input type="hidden" name="chunk_id" value={ vm.FocusChunk }/>
				<input type="hidden" name="char_start"/>
				<input type="hidden" name="char_end"/>
				<input type="hidden" name="text"/>
				<button type="submit" class="excerpt-add" data-attr:disabled="!$focusId">
					Add as evidence
				</button>
				<span class="excerpt-hint">Select text above to attach just that span.</span>
			</form>
		}
	</div>
}
