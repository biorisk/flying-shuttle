package components

import (
	"fmt"
	"github.com/biorisk/flying-shuttle/internal/web/viewmodel"
)

// Ingest is the left-drawer fragment: a transcript upload form and the list of
// uploaded files with their processing status. Rendered into #ingest by
// GET /ingest and re-patched by POST /ingest. While any upload is
// still processing the fragment polls itself every 2s.
templ Ingest(vm viewmodel.IngestDrawer) {
	<div
		id="ingest"
		class="drawer-body"
		if vm.Active {
			data-on:interval__duration.2s="@get('/ingest')"
		}
	>
		<form
			class="ingest-form"
			enctype="multipart/form-data"
			data-on:submit__prevent="@post('/ingest', {contentType: 'form'})"
		>
			<label class="ingest-drop">
				<input type="file" name="files" multiple accept=".txt,.md,.markdown,.text"/>
				<span>Choose transcript files (.txt, .md)</span>
			</label>
			<button type="submit" class="ingest-submit">Upload &amp; process</button>
		</form>
		if len(vm.Uploads) > 0 {
			<ul class="upload-list">
				for _, u := range vm.Uploads {
					<li class={ "upload-row", "status-" + u.Status }>
						<span class="upload-name" title={ u.Filename }>{ u.Filename }</span>
						<span class="upload-status">{ u.Status }</span>
						if u.Error != "" {
							<span class="upload-error" title={ u.Error }>!</span>
						}
					</li>
				}
			</ul>
		} else {
			<p class="ingest-empty">No transcripts loaded yet.</p>
		}
		<p class="ingest-hint">{ fmt.Sprintf("%d file(s)", len(vm.Uploads)) }</p>
	</div>
}
