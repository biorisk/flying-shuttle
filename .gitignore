.beads/*
!.beads/issues.jsonl
!.beads/config.yaml
!.beads/.gitignore

# Go
/bin/
/vendor/

# SQLite
*.db
*.db-shm
*.db-wal

# Search index snapshots (rebuilt from the DB)
*.bm25
*.hnsw

# Python
__pycache__/
/python/.venv/

# Uploaded transcript files
uploads/

# Dolt database files (added by bd init)
.dolt/

# Reference docs (binary)
*.pdf

# Beads / Dolt files (added by bd init)
.beads-credential-key
.beads/proxieddb/
